{
  "openapi": "3.1.0",
  "info": {
    "title": "Products API",
    "version": "1.0.0"
  },
  "paths": {
    "/products/{product_id}": {
      "patch": {
        "tags": ["products"],
        "operationId": "update_products",
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "publish",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated product",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "name"],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "details": {
                      "type": "object",
                      "required": ["label"],
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "variants": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "required": ["kind", "quantity"],
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "stock"
                              },
                              "quantity": {
                                "type": "integer",
                                "minimum": 0
                              }
                            }
                          },
                          {
                            "type": "object",
                            "required": ["kind", "url"],
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "download"
                              },
                              "url": {
                                "type": "string",
                                "format": "uri"
                              }
                            }
                          }
                        ]
                      }
                    },
                    "counts": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid product",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["reason"],
                  "properties": {
                    "reason": {
                      "type": "string",
                      "enum": ["invalid_name", "name_taken"]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Product not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["reason"],
                  "properties": {
                    "reason": {
                      "type": "string",
                      "const": "not_found"
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Created without a body"
          },
          "202": {
            "description": "Unconstrained JSON",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "204": {
            "description": "No content",
            "content": {}
          },
          "409": {
            "$ref": "#/components/responses/EmptyConflict"
          },
          "410": {
            "$ref": "#/components/responses/JsonError"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "EmptyConflict": {
        "description": "Conflict without a body"
      },
      "JsonError": {
        "description": "Unconstrained JSON error",
        "content": {
          "application/json": {
            "schema": {}
          }
        }
      }
    }
  }
}
