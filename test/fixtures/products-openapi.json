{
  "openapi": "3.1.0",
  "info": {
    "title": "Products API",
    "version": "1.0.0"
  },
  "paths": {
    "/products/{product_id}": {
      "patch": {
        "tags": ["products"],
        "operationId": "update_products",
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "publish",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated product",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "name"],
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid product",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["reason"],
                  "properties": {
                    "reason": {
                      "type": "string",
                      "enum": ["invalid_name", "name_taken"]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Product not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["reason"],
                  "properties": {
                    "reason": { "type": "string", "const": "not_found" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
